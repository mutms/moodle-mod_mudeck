{{!
    @template mod_mudeck/present

    Slide deck presentation page.

    Context variables required for this template:
    * partsjson - JSON encoded list of parts, each with its Markdown and theme
    * themecssjson - JSON encoded map of theme name to CSS shipped with the plugin
    * exiturljson - JSON encoded URL back to the welcome page
    * labelsjson - JSON encoded labels for the presentation controls
    * syncjson - JSON encoded {url, sesskey} for device sync, or null when it is off
    * reachedendjson - JSON encoded {url, sesskey} to report the last slide for completion, or null
    * notesjson - JSON encoded true when the speaker notes may be toggled on
    * startslidejson - JSON encoded slide to open on, or null for the first

    Example context (json):
    {
        "partsjson": "[]",
        "themecssjson": "{}",
        "exiturljson": "\"/mod/mudeck/view.php?id=1\"",
        "labelsjson": "{}",
        "syncjson": "null",
        "reachedendjson": "null",
        "notesjson": "false",
        "startslidejson": "null"
    }
}}
{{#react}}
{
    "component": "@moodle/lms/mod_mudeck/viewer",
    "props": {
        "parts": {{{partsjson}}},
        "themecss": {{{themecssjson}}},
        "exiturl": {{{exiturljson}}},
        "labels": {{{labelsjson}}},
        "sync": {{{syncjson}}},
        "reachedend": {{{reachedendjson}}},
        "notes": {{{notesjson}}},
        "startslide": {{{startslidejson}}}
    },
    "id": "mudeck-viewer",
    "class": "mudeck-present"
}
<p>{{#str}}loading, mod_mudeck{{/str}}</p>
{{/react}}
